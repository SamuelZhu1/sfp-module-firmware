CONFIG_IDF_TARGET="esp32c3"
# Console and shell over the chip's own USB (the same port carries JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms ticks so backoff and t_init waits are not rounded to 10 ms
CONFIG_FREERTOS_HZ=1000
# keep log lines off the JSON shell unless something is wrong
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584
